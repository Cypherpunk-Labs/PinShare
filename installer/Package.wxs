<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?define ProductName = "PinShare" ?>
  <!-- ProductVersion is passed from wixproj via DefineConstants, with fallback -->
  <?ifndef ProductVersion ?>
    <?define ProductVersion = "1.0.0" ?>
  <?endif ?>
  <?define Manufacturer = "PinShare Contributors" ?>
  <?define UpgradeCode = "12345678-1234-1234-1234-123456789012" ?>

  <Package Name="$(var.ProductName)"
           Version="$(var.ProductVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)"
           Language="1033"
           Compressed="yes"
           InstallerVersion="500"
           Scope="perMachine">

    <SummaryInformation Description="PinShare - Decentralized IPFS Pinning Service"
                        Comments="$(var.ProductVersion)" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <Media Id="1" Cabinet="PinShare.cab" EmbedCab="yes" />

    <!-- Configurable properties - can be set via command line -->
    <!-- Example: msiexec /i PinShare-Setup.msi ORG_NAME="MyCompany" UI_PORT="9000" -->
    <Property Id="ORG_NAME" Value="MyOrganization" Secure="yes" />
    <Property Id="GROUP_NAME" Value="MyGroup" Secure="yes" />
    <Property Id="UI_PORT" Value="8888" Secure="yes" />
    <Property Id="PINSHARE_API_PORT" Value="9090" Secure="yes" />
    <Property Id="PINSHARE_P2P_PORT" Value="50001" Secure="yes" />
    <Property Id="IPFS_API_PORT" Value="5001" Secure="yes" />
    <Property Id="IPFS_GATEWAY_PORT" Value="8080" Secure="yes" />
    <Property Id="IPFS_SWARM_PORT" Value="4001" Secure="yes" />
    <Property Id="SKIP_VIRUSTOTAL" Value="0" Secure="yes" />
    <Property Id="ENABLE_CACHE" Value="1" Secure="yes" />
    <Property Id="ARCHIVE_NODE" Value="0" Secure="yes" />
    <Property Id="LOG_LEVEL" Value="info" Secure="yes" />
    <!-- Startup options: 1 = yes, 0 = no -->
    <Property Id="START_SERVICE_NOW" Value="1" Secure="yes" />
    <Property Id="START_TRAY_NOW" Value="1" Secure="yes" />
    <Property Id="SERVICE_AUTO_START" Value="1" Secure="yes" />
    <Property Id="TRAY_AUTO_START" Value="1" Secure="yes" />

    <!-- Icons -->
    <!-- TEMPORARILY DISABLED: icon.ico file not yet created -->
    <!-- <Icon Id="PinShareIcon" SourceFile="icon.ico" /> -->
    <!-- <Property Id="ARPPRODUCTICON" Value="PinShareIcon" /> -->

    <!-- UI - Use WixUI_InstallDir with custom configuration dialog -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UIRef Id="PinShareConfigUI" />

    <!-- Custom actions -->
    <CustomAction Id="StartService"
                  FileRef="PinShareSvcExe"
                  ExeCommand="start"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />

    <CustomAction Id="StopService"
                  FileRef="PinShareSvcExe"
                  ExeCommand="stop"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />

    <CustomAction Id="InstallService"
                  FileRef="PinShareSvcExe"
                  ExeCommand="install"
                  Execute="deferred"
                  Return="check"
                  Impersonate="no" />

    <CustomAction Id="UninstallService"
                  FileRef="PinShareSvcExe"
                  ExeCommand="uninstall"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />

    <!-- Start tray application after install -->
    <CustomAction Id="StartTray"
                  FileRef="PinShareTrayExe"
                  ExeCommand=""
                  Execute="deferred"
                  Return="asyncNoWait"
                  Impersonate="yes" />

    <InstallExecuteSequence>
      <!-- Stop service before uninstall -->
      <Custom Action="StopService" Before="RemoveFiles" Condition="Installed AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="UninstallService" Before="RemoveFiles" Condition="Installed AND NOT UPGRADINGPRODUCTCODE" />

      <!-- Install service (always install, but only start if START_SERVICE_NOW=1) -->
      <Custom Action="InstallService" After="InstallFiles" Condition="NOT Installed AND SERVICE_AUTO_START=1" />
      <Custom Action="StartService" After="InstallService" Condition="NOT Installed AND START_SERVICE_NOW=1" />

      <!-- Start tray application if START_TRAY_NOW=1 -->
      <Custom Action="StartTray" After="StartService" Condition="NOT Installed AND START_TRAY_NOW=1" />
    </InstallExecuteSequence>

    <!-- Features -->
    <Feature Id="ProductFeature"
             Title="PinShare"
             Level="1"
             Description="Core PinShare application">
      <ComponentGroupRef Id="ProductComponents" />
      <!-- TEMPORARILY DISABLED: UI will be added from infra/refactor branch later -->
      <!-- <ComponentGroupRef Id="UIComponents" /> -->
      <ComponentRef Id="RegistryEntries" />
      <ComponentRef Id="DataDirectories" />
      <ComponentRef Id="StartupEntry" />
      <ComponentRef Id="Shortcuts" />
    </Feature>

    <!-- Directory structure -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PinShare">
        <!-- TEMPORARILY DISABLED: UI will be added from infra/refactor branch later -->
        <!-- <Directory Id="UIFolder" Name="ui" /> -->
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DataFolder" Name="PinShare">
        <Directory Id="LogsFolder" Name="logs" />
        <Directory Id="IPFSDataFolder" Name="ipfs" />
        <Directory Id="PinShareDataFolder" Name="pinshare" />
        <Directory Id="UploadFolder" Name="upload" />
        <Directory Id="CacheFolder" Name="cache" />
        <Directory Id="RejectedFolder" Name="rejected" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="PinShare" />
    </StandardDirectory>

    <StandardDirectory Id="StartupFolder" />

  </Package>

  <!-- Components -->
  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">

      <!-- Main executables -->
      <Component Id="PinShareSvc" Bitness="always64">
        <File Id="PinShareSvcExe"
              Name="pinsharesvc.exe"
              Source="..\dist\windows\pinsharesvc.exe" />
      </Component>

      <Component Id="PinShareBackend" Bitness="always64">
        <File Id="PinShareExe"
              Name="pinshare.exe"
              Source="..\dist\windows\pinshare.exe" />
      </Component>

      <Component Id="PinShareTray" Bitness="always64">
        <File Id="PinShareTrayExe"
              Name="pinshare-tray.exe"
              Source="..\dist\windows\pinshare-tray.exe" />
      </Component>

      <Component Id="IPFS" Bitness="always64">
        <File Id="IPFSExe"
              Name="ipfs.exe"
              Source="..\dist\windows\ipfs.exe" />
      </Component>

      <!-- TEMPORARILY DISABLED: icon.ico file not yet created -->
      <!--
      <Component Id="Icon" Bitness="always64">
        <File Id="IconFile"
              Name="icon.ico"
              Source="icon.ico" />
      </Component>
      -->

    </ComponentGroup>
  </Fragment>

  <!-- Shortcuts -->
  <Fragment>
    <Component Id="Shortcuts" Directory="ApplicationProgramsFolder" Bitness="always64">
      <!-- TEMPORARILY DISABLED: URL shortcuts require different approach -->
      <!-- Users can access UI via system tray application -->
      <!--
      <Shortcut Id="PinShareUIShortcut"
                Name="Open PinShare UI"
                Target="http://localhost:8888/" />
      -->

      <Shortcut Id="UninstallShortcut"
                Name="Uninstall PinShare"
                Target="[System64Folder]msiexec.exe"
                Arguments="/x [ProductCode]" />

      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />

      <RegistryValue Root="HKCU"
                     Key="Software\PinShare"
                     Name="installed"
                     Type="integer"
                     Value="1" />
    </Component>
  </Fragment>

  <!-- TEMPORARILY DISABLED: UI will be added from infra/refactor branch later -->
  <!--
  <Fragment>
    <ComponentGroup Id="UIComponents" Directory="UIFolder">
      This will be auto-generated by heat/HarvestDirectory in .wixproj
    </ComponentGroup>
  </Fragment>
  -->

  <!-- Registry entries - values from installer dialog properties -->
  <Fragment>
    <Component Id="RegistryEntries" Directory="INSTALLFOLDER" Bitness="always64">
      <RegistryKey Root="HKLM" Key="SOFTWARE\PinShare">
        <!-- Installation paths -->
        <RegistryValue Name="InstallDirectory" Type="string" Value="[INSTALLFOLDER]" />
        <RegistryValue Name="DataDirectory" Type="string" Value="[DATA_FOLDER]" />
        <RegistryValue Name="LogsDirectory" Type="string" Value="[LOGS_FOLDER]" />
        <RegistryValue Name="UploadDirectory" Type="string" Value="[UPLOAD_FOLDER]" />
        <RegistryValue Name="CacheDirectory" Type="string" Value="[CACHE_FOLDER]" />
        <RegistryValue Name="IPFSBinary" Type="string" Value="[INSTALLFOLDER]ipfs.exe" />
        <RegistryValue Name="PinShareBinary" Type="string" Value="[INSTALLFOLDER]pinshare.exe" />

        <!-- Ports - user configurable -->
        <RegistryValue Name="IPFSAPIPort" Type="string" Value="[IPFS_API_PORT]" />
        <RegistryValue Name="IPFSGatewayPort" Type="string" Value="[IPFS_GATEWAY_PORT]" />
        <RegistryValue Name="IPFSSwarmPort" Type="string" Value="[IPFS_SWARM_PORT]" />
        <RegistryValue Name="PinShareAPIPort" Type="string" Value="[PINSHARE_API_PORT]" />
        <RegistryValue Name="PinShareP2PPort" Type="string" Value="[PINSHARE_P2P_PORT]" />
        <RegistryValue Name="UIPort" Type="string" Value="[UI_PORT]" />

        <!-- Organization configuration - user configurable -->
        <RegistryValue Name="OrgName" Type="string" Value="[ORG_NAME]" />
        <RegistryValue Name="GroupName" Type="string" Value="[GROUP_NAME]" />

        <!-- Feature toggles - user configurable -->
        <RegistryValue Name="SkipVirusTotal" Type="string" Value="[SKIP_VIRUSTOTAL]" />
        <RegistryValue Name="EnableCache" Type="string" Value="[ENABLE_CACHE]" />
        <RegistryValue Name="ArchiveNode" Type="string" Value="[ARCHIVE_NODE]" />
        <RegistryValue Name="LogLevel" Type="string" Value="[LOG_LEVEL]" />
      </RegistryKey>
    </Component>
  </Fragment>

  <!-- Data directories -->
  <Fragment>
    <Component Id="DataDirectories" Directory="DataFolder" Bitness="always64">
      <CreateFolder Directory="LogsFolder" />
      <CreateFolder Directory="IPFSDataFolder" />
      <CreateFolder Directory="PinShareDataFolder" />
      <CreateFolder Directory="UploadFolder" />
      <CreateFolder Directory="CacheFolder" />
      <CreateFolder Directory="RejectedFolder" />

      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\PinShare"
                     Name="DataCreated"
                     Type="integer"
                     Value="1" />
    </Component>
  </Fragment>

  <!-- Startup entry for tray app -->
  <Fragment>
    <Component Id="StartupEntry" Directory="StartupFolder" Bitness="always64">
      <Shortcut Id="StartupShortcut"
                Name="PinShare Tray"
                Description="PinShare System Tray"
                Target="[INSTALLFOLDER]pinshare-tray.exe"
                WorkingDirectory="INSTALLFOLDER" />

      <RegistryValue Root="HKCU"
                     Key="Software\PinShare"
                     Name="startupentry"
                     Type="integer"
                     Value="1" />
    </Component>
  </Fragment>

</Wix>
