<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <?define ProductName = "PinShare" ?>
  <?define ProductVersion = "1.0.0" ?>
  <?define Manufacturer = "PinShare Contributors" ?>
  <?define UpgradeCode = "24D1704E-0ACD-4370-BCF9-ED664A546060" ?>

  <Product Id="*"
           Name="$(var.ProductName)"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="PinShare - Decentralized IPFS Pinning Service"
             Comments="$(var.ProductVersion)" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Icons -->
    <Icon Id="PinShareIcon" SourceFile="icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="PinShareIcon" />

    <!-- UI -->
    <UIRef Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <!-- Custom actions -->
    <CustomAction Id="StartService"
                  FileKey="PinShareSvcExe"
                  ExeCommand="start"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />

    <CustomAction Id="StopService"
                  FileKey="PinShareSvcExe"
                  ExeCommand="stop"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />

    <CustomAction Id="InstallService"
                  FileKey="PinShareSvcExe"
                  ExeCommand="install"
                  Execute="deferred"
                  Return="check"
                  Impersonate="no" />

    <CustomAction Id="UninstallService"
                  FileKey="PinShareSvcExe"
                  ExeCommand="uninstall"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />

    <InstallExecuteSequence>
      <!-- Stop service before uninstall -->
      <Custom Action="StopService" Before="RemoveFiles">Installed AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="UninstallService" Before="RemoveFiles">Installed AND NOT UPGRADINGPRODUCTCODE</Custom>

      <!-- Install and start service after install -->
      <Custom Action="InstallService" After="InstallFiles">NOT Installed</Custom>
      <Custom Action="StartService" After="InstallService">NOT Installed</Custom>
    </InstallExecuteSequence>

    <!-- Features -->
    <Feature Id="ProductFeature"
             Title="PinShare"
             Level="1"
             Description="Core PinShare application">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="UIComponents" />
      <ComponentRef Id="RegistryEntries" />
      <ComponentRef Id="DataDirectories" />
      <ComponentRef Id="StartupEntry" />
    </Feature>

    <!-- Directory structure -->
    <Directory Id="TARGETDIR" Name="SourceDir">

      <!-- Program Files -->
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="PinShare">
          <Directory Id="UIFolder" Name="ui" />
        </Directory>
      </Directory>

      <!-- ProgramData -->
      <Directory Id="CommonAppDataFolder">
        <Directory Id="DataFolder" Name="PinShare">
          <Directory Id="LogsFolder" Name="logs" />
          <Directory Id="IPFSDataFolder" Name="ipfs" />
          <Directory Id="PinShareDataFolder" Name="pinshare" />
          <Directory Id="UploadFolder" Name="upload" />
          <Directory Id="CacheFolder" Name="cache" />
          <Directory Id="RejectedFolder" Name="rejected" />
        </Directory>
      </Directory>

      <!-- Startup -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="PinShare" />
      </Directory>

      <!-- Startup folder for tray app -->
      <Directory Id="StartupFolder" />

    </Directory>
  </Product>

  <!-- Components -->
  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">

      <!-- Main executables -->
      <Component Id="PinShareSvc" Guid="*">
        <File Id="PinShareSvcExe"
              Name="pinsharesvc.exe"
              Source="..\dist\windows\pinsharesvc.exe"
              KeyPath="yes" />
      </Component>

      <Component Id="PinShareBackend" Guid="*">
        <File Id="PinShareExe"
              Name="pinshare.exe"
              Source="..\dist\windows\pinshare.exe"
              KeyPath="yes" />
      </Component>

      <Component Id="PinShareTray" Guid="*">
        <File Id="PinShareTrayExe"
              Name="pinshare-tray.exe"
              Source="..\dist\windows\pinshare-tray.exe"
              KeyPath="yes" />
      </Component>

      <Component Id="IPFS" Guid="*">
        <File Id="IPFSExe"
              Name="ipfs.exe"
              Source="..\dist\windows\ipfs.exe"
              KeyPath="yes" />
      </Component>

      <Component Id="Icon" Guid="*">
        <File Id="IconFile"
              Name="icon.ico"
              Source="icon.ico"
              KeyPath="yes" />
      </Component>

      <!-- Shortcuts -->
      <Component Id="Shortcuts" Guid="*" Directory="ApplicationProgramsFolder">
        <Shortcut Id="PinShareUIShortcut"
                  Name="Open PinShare UI"
                  Target="http://localhost:8888/"
                  Icon="PinShareIcon" />

        <Shortcut Id="UninstallShortcut"
                  Name="Uninstall PinShare"
                  Target="[System64Folder]msiexec.exe"
                  Arguments="/x [ProductCode]" />

        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />

        <RegistryValue Root="HKCU"
                       Key="Software\PinShare"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

  <!-- UI Components (static files) -->
  <Fragment>
    <ComponentGroup Id="UIComponents" Directory="UIFolder">
      <Component Id="UIFiles" Guid="*">
        <File Id="IndexHtml" Name="index.html" Source="..\dist\windows\ui\index.html" KeyPath="yes" />
        <!-- Add more UI files as needed - WiX heat.exe can auto-generate this -->
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- Registry entries -->
  <Fragment>
    <Component Id="RegistryEntries" Directory="INSTALLFOLDER" Guid="*">
      <RegistryKey Root="HKLM" Key="SOFTWARE\PinShare">
        <RegistryValue Name="InstallDirectory" Type="string" Value="[INSTALLFOLDER]" />
        <RegistryValue Name="DataDirectory" Type="string" Value="[DataFolder]" />
        <RegistryValue Name="IPFSBinary" Type="string" Value="[INSTALLFOLDER]ipfs.exe" />
        <RegistryValue Name="PinShareBinary" Type="string" Value="[INSTALLFOLDER]pinshare.exe" />

        <!-- Ports -->
        <RegistryValue Name="IPFSAPIPort" Type="integer" Value="5001" />
        <RegistryValue Name="IPFSGatewayPort" Type="integer" Value="8080" />
        <RegistryValue Name="IPFSSwarmPort" Type="integer" Value="4001" />
        <RegistryValue Name="PinShareAPIPort" Type="integer" Value="9090" />
        <RegistryValue Name="PinShareP2PPort" Type="integer" Value="50001" />
        <RegistryValue Name="UIPort" Type="integer" Value="8888" />

        <!-- Configuration -->
        <RegistryValue Name="OrgName" Type="string" Value="MyOrganization" />
        <RegistryValue Name="GroupName" Type="string" Value="MyGroup" />
        <RegistryValue Name="SkipVirusTotal" Type="integer" Value="1" />
        <RegistryValue Name="EnableCache" Type="integer" Value="1" />
        <RegistryValue Name="ArchiveNode" Type="integer" Value="0" />
        <RegistryValue Name="LogLevel" Type="string" Value="info" />

        <RegistryValue Type="string" Value="PinShare" KeyPath="yes" />
      </RegistryKey>
    </Component>
  </Fragment>

  <!-- Data directories -->
  <Fragment>
    <Component Id="DataDirectories" Directory="DataFolder" Guid="*">
      <CreateFolder Directory="LogsFolder" />
      <CreateFolder Directory="IPFSDataFolder" />
      <CreateFolder Directory="PinShareDataFolder" />
      <CreateFolder Directory="UploadFolder" />
      <CreateFolder Directory="CacheFolder" />
      <CreateFolder Directory="RejectedFolder" />

      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\PinShare"
                     Name="DataCreated"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- Startup entry for tray app -->
  <Fragment>
    <Component Id="StartupEntry" Directory="StartupFolder" Guid="*">
      <Shortcut Id="StartupShortcut"
                Name="PinShare Tray"
                Description="PinShare System Tray"
                Target="[INSTALLFOLDER]pinshare-tray.exe"
                WorkingDirectory="INSTALLFOLDER" />

      <RegistryValue Root="HKCU"
                     Key="Software\PinShare"
                     Name="startupentry"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>

</Wix>
