    <HarvestDirectory Include="$(SolutionDir)..\dist\windows\ui">
      <ComponentGroupName>UIComponents</ComponentGroupName>
      <DirectoryRefId>UIFolder</DirectoryRefId>
      <PreprocessorVariable>var.UISourceDir</PreprocessorVariable>
      <SuppressFragments>true</SuppressFragments>
      <SuppressRegistry>true</SuppressRegistry>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>
  </ItemGroup>

  <PropertyGroup>
    <DefineConstants>
      UISourceDir=$(SolutionDir)..\dist\windows\ui
    </DefineConstants>
  </PropertyGroup>
  -->

</Project>
