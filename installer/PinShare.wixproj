<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputName>PinShare-Setup</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <!-- ProductVersion can be overridden via command line: -p:ProductVersion=1.2.3 -->
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
  </PropertyGroup>

  <!-- Pass version to WiX preprocessor -->
  <PropertyGroup>
    <DefineConstants>ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>

  <!-- WiX UI Extension for installer dialogs -->
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.*" />
  </ItemGroup>

  <!-- SDK automatically globs *.wxs files - no explicit Compile needed -->

  <!-- TEMPORARILY DISABLED: UI will be added from infra/refactor branch later -->
  <!--
